{{- $config := dict -}}
{{- if stat .chezmoi.configFile -}}
  {{- if ne (lower (ext .chezmoi.configFile)) ".json" -}}
    {{- fail "Existing chezmoi configuration is not JSON; migrate it to chezmoi.json before initializing" -}}
  {{- end -}}
  {{- $config = include .chezmoi.configFile | fromJsonc -}}
{{- end -}}
{{- $data := get $config "data" | default (dict) -}}
{{- $host := lower .chezmoi.hostname -}}
{{- $user := lower .chezmoi.username -}}
{{- $_ := set $data "work" (or (contains "frsilb" $host) (contains "frsilb" $user) (and (eq .chezmoi.os "linux") (eq $host "fred-desk"))) -}}
{{- if eq .chezmoi.os "windows" -}}
  {{- $profile := output "pwsh" "-NoLogo" "-NoProfile" "-NonInteractive" "-Command" "$PROFILE.CurrentUserAllHosts | ConvertTo-Json -Compress" | fromJson | replace "\\" "/" | lower -}}
  {{- $profileDirectory := "" -}}
  {{- range list "Documents/PowerShell" "OneDrive - Microsoft/Documents/PowerShell" -}}
    {{- if eq $profile (joinPath $.chezmoi.homeDir . "profile.ps1" | replace "\\" "/" | lower) -}}
      {{- $profileDirectory = . -}}
    {{- end -}}
  {{- end -}}
  {{- if eq $profileDirectory "" -}}
    {{- fail "Unsupported PowerShell profile location; add its source path and conditional ignore before initializing" -}}
  {{- end -}}
  {{- $_ := set $data "powershellProfileDirectory" $profileDirectory -}}
{{- end -}}
{{- $_ := set $config "data" $data -}}
{{ $config | toPrettyJson }}
