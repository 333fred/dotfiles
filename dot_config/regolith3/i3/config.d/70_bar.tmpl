bar {
    font pango:Monaspace Neon 10
    position top
    status_command /home/fred/.cargo/bin/i3status-rs
    output $wm.mainOutput
    tray_output $wm.mainOutput
    strip_workspace_numbers yes
    workspace_min_width 40
    colors {
        background $base00
        separator  $base01
        statusline $base04
    
        # State             Border  BG      Text
        focused_workspace   $base05 $base0D $base00
        active_workspace    $base05 $base03 $base00
        inactive_workspace  $base03 $base01 $base05
        urgent_workspace    $base08 $base08 $base00
        binding_mode        $base00 $base0A $base00
    }
}

bar {
    font pango:Monaspace Neon 12
    position top
    status_command /home/fred/.cargo/bin/i3status-rs /home/fred/.config/i3status-rust/secondary.config.toml
    output $wm.secondaryOutput
    tray_output none
    strip_workspace_numbers yes
    workspace_min_width 40
    colors {
        background $base00
        separator  $base01
        statusline $base04
    
        # State             Border  BG      Text
        focused_workspace   $base05 $base0D $base00
        active_workspace    $base05 $base03 $base00
        inactive_workspace  $base03 $base01 $base05
        urgent_workspace    $base08 $base08 $base00
        binding_mode        $base00 $base0A $base00
    }
}
