# Homebrew packages for macOS
# Install with: brew bundle --file=~/git/dotfiles/Brewfile

# Core tools
brew "git"
brew "vim"
brew "stow"
brew "curl"
brew "grep"
brew "coreutils"     # GNU core utilities (gls, gdircolors, etc.)
brew "findutils"     # GNU find/xargs/locate

# Shell
brew "zsh"
brew "bash"
brew "bash-completion@2"

# Development
brew "gh"            # GitHub CLI
brew "cmake"
brew "pkg-config"

# Terminal tools
brew "bat"           # cat replacement with syntax highlighting
brew "delta"         # git diff viewer
brew "fzy"           # fuzzy finder (for enhancd)
brew "less"

# GPG & Security
brew "gnupg"
brew "pinentry-mac"

# Fonts (via cask)
cask "font-monaspace"
cask "font-hack-nerd-font"
cask "font-noto-sans"
cask "font-noto-serif"
cask "font-noto-sans-cjk"

# Applications
cask "alacritty"
cask "visual-studio-code"

# Rust toolchain (for cargo-based tools)
brew "rustup"
