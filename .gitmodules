[submodule "zsh/.zprezto"]
	path = zsh/.zprezto
	url = https://github.com/sorin-ionescu/prezto.git
[submodule "zsh/.prezto-contrib"]
	path = zsh/.prezto-contrib
	url = https://github.com/belak/prezto-contrib.git
[submodule "zsh/.modules/zsh-vi-mode"]
	path = zsh/.modules/zsh-vi-mode
	url = https://github.com/jeffreytse/zsh-vi-mode.git
[submodule "zsh/.modules/spaceship-prompt"]
	path = zsh/.modules/spaceship-prompt
	url = https://github.com/spaceship-prompt/spaceship-prompt.git
[submodule "zsh/.modules/spaceship-vi-mode"]
	path = zsh/.modules/spaceship-vi-mode
	url = https://github.com/spaceship-prompt/spaceship-vi-mode.git
