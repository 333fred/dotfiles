[submodule "zsh/.zprezto"]
	path = zsh/.zprezto
	url = git@github.com:sorin-ionescu/prezto.git
[submodule "config/.config/base16-shell"]
	path = config/.config/base16-shell
	url = git@github.com:chriskempson/base16-shell.git
[submodule "zsh/.prezto-contrib"]
	path = zsh/.prezto-contrib
	url = git@github.com:belak/prezto-contrib.git
[submodule "tools/.tools/roslynpad"]
	path = tools/.tools/roslynpad
	url = git@github.com:roslynpad/roslynpad.git
[submodule "zsh/.modules/zsh-vi-mode"]
	path = zsh/.modules/zsh-vi-mode
	url = git@github.com:jeffreytse/zsh-vi-mode.git
[submodule "tools/.tools/MSBuildStructuredLog"]
	path = tools/.tools/MSBuildStructuredLog
	url = git@github.com:KirillOsenkov/MSBuildStructuredLog.git
[submodule "zsh/.modules/spaceship-vi-mode"]
	path = zsh/.modules/spaceship-vi-mode
	url = git@github.com:spaceship-prompt/spaceship-vi-mode.git
